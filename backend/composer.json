{
    "name": "store-ordering/backend",
    "description": "Backend for the store ordering application",
    "type": "project",
    "require": {
        "php": "~8.5.0",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.12"
        },
        "sort-packages": true
    }
}
